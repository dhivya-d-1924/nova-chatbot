# Copy to backend/.env and fill in. Placeholders only: never commit a real .env.
# Every setting is optional in development; production refuses to start with unsafe values (see DEPLOYMENT.md).

# --- Environment: development | testing | production ---
APP_ENV=development

# --- LLM provider (any OpenAI-compatible API) ---
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Leave empty for OpenAI. Examples:
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter:    https://openrouter.ai/api/v1
#   Groq:          https://api.groq.com/openai/v1
#   Ollama:        http://localhost:11434/v1   (LLM_API_KEY may be any text)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
# Automatic retries with exponential backoff for connection errors, 429 and 5xx
LLM_MAX_RETRIES=2
# Ask the provider for token counts while streaming (turn off if your provider rejects stream_options)
LLM_STREAM_USAGE=true
# Prices in USD per million tokens, for the cost estimates on the admin dashboard (0 = not shown)
LLM_PRICE_INPUT_PER_1M=0
LLM_PRICE_OUTPUT_PER_1M=0
SYSTEM_PROMPT=You are a helpful, accurate AI assistant. Answer clearly, use Markdown for structure and fenced code blocks for code, and ask a short clarifying question when a request is ambiguous.

# --- Semantic document search (optional) ---
# An embeddings model enables meaning-based search combined with keyword search, e.g. text-embedding-3-small.
# Defaults to the LLM provider's URL and key; override if embeddings come from elsewhere.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Database ---
# SQLite (default, file next to app.py):  sqlite:///chat.db
# MySQL:  mysql+pymysql://user:password@localhost:3306/chatbot   (pip install pymysql)
DATABASE_URL=sqlite:///chat.db

# --- Web, cookies and origins ---
# Public address of the frontend (email links, origin checks). Must be https in production.
APP_URL=http://localhost:5173
# Origins allowed to call the API with credentials (comma-separated, never *). Needed for split hosting.
ALLOWED_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (nginx = 1). 0 ignores X-Forwarded-For (it can be spoofed).
TRUSTED_PROXY_COUNT=0
# Lax works for same-site hosting. Use None (with HTTPS) only when frontend and API are on different sites.
COOKIE_SAMESITE=Lax
# Defaults to true in production. Only set ALLOW_INSECURE_HTTP=true for a local production test without TLS.
# COOKIE_SECURE=
# ALLOW_INSECURE_HTTP=
PORT=5000
# HOST=0.0.0.0 makes the dev server reachable from phones/tablets on your network
# HOST=127.0.0.1

# --- Secrets ---
# Required in production: a long random value. python -c "import secrets;print(secrets.token_hex(32))"
# In development a random key is created in backend/.secret_key.
SECRET_KEY=
# Optional separate key for encrypting MFA secrets at rest (defaults to SECRET_KEY). Changing it disables existing MFA.
DATA_ENCRYPTION_KEY=

# --- Accounts ---
# Sessions: absolute lifetime and idle timeout
SESSION_DAYS=30
SESSION_IDLE_HOURS=168
REGISTRATION_OPEN=true
# Development default: the first account becomes administrator. Production default is false:
# create the first admin with:  flask --app app create-admin --email you@example.com
# BOOTSTRAP_FIRST_ADMIN=
# Emails that become admins once VERIFIED (only honoured when REQUIRE_EMAIL_VERIFICATION is on in production)
ADMIN_EMAILS=
# Defaults to true in production when SMTP_HOST is set
# REQUIRE_EMAIL_VERIFICATION=
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
MFA_ISSUER=Nova
# Email for verification/reset links. Without SMTP_HOST, links are printed in the terminal (development only).
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Rate limits, quotas and cost controls ---
# Shared store for limits when running several workers/servers (pip install redis)
REDIS_URL=
RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_HOUR=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20
API_RATE_LIMIT_PER_MINUTE=300
MAX_CONCURRENT_STREAMS_PER_USER=2
# 0 = unlimited
DAILY_TOKEN_LIMIT_PER_USER=0
MONTHLY_BUDGET_USD=0

# --- Chat ---
MAX_HISTORY_MESSAGES=30
MAX_MESSAGE_CHARS=8000
# Summarize older messages when a conversation outgrows MAX_HISTORY_MESSAGES
SUMMARIZE_HISTORY=true

# --- Documents ---
MAX_UPLOAD_MB=15
MAX_DOCS_PER_USER=30
MAX_PDF_PAGES=500
RAG_TOP_K=6
# OCR for scanned PDFs and images (needs the tesseract program plus pytesseract and pypdfium2)
OCR_ENABLED=true
OCR_MAX_PAGES=30

# --- Agent tools ---
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=180
TOOL_TIMEOUT_SECONDS=30
APPROVAL_TTL_MINUTES=60
# Web search: ddg (no key; needs `pip install ddgs`), tavily or brave (need a key), none
SEARCH_PROVIDER=ddg
TAVILY_API_KEY=
BRAVE_API_KEY=
# Approved sources for search results and page reading, comma-separated (empty = any public website)
ALLOWED_DOMAINS=
# Only set if outbound traffic must go through an egress proxy (disables the connect-time IP check)
FETCH_PROXY=
# Limit who the agent may email, comma-separated domains (empty = any)
EMAIL_ALLOWED_DOMAINS=
# Optional read-only business database for admins. Sample: python make_demo_db.py, then
#   AGENT_DATABASE_URL=sqlite:///demo_business.db
#   AGENT_DB_TABLES=customers,products,orders
# For real data, connect as a database user that only has SELECT on the exposed tables.
AGENT_DATABASE_URL=
AGENT_DB_TABLES=

# --- Images, memory ---
MAX_IMAGE_MB=5
MEMORY_LIMIT=100

# --- Retention, logging, alerts ---
# Logs (errors, tool use, audit, usage) older than this are deleted
LOG_RETENTION_DAYS=90
# 0 = keep conversations until the user deletes them; otherwise delete unpinned chats idle this long
CHAT_RETENTION_DAYS=0
# json (default in production) or text
LOG_FORMAT=
LOG_LEVEL=INFO
# Alert when errors in 10 minutes exceed the threshold (webhook receives {"text": "..."}, e.g. Slack)
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
ALERT_ERROR_THRESHOLD=20

# --- Channels: chat with Nova from WhatsApp, Microsoft Teams and email (see CHANNELS.md) ---
# Each channel turns on when its credentials are filled in. Staff link their own accounts in Account > Apps.
# "command": search documents only when a message starts with "docs ...";  "always";  "off"
CHANNEL_DOCUMENTS=command
CHANNEL_LINK_CODE_MINUTES=10
CHANNEL_RATE_LIMIT_PER_MINUTE=10

# WhatsApp (Meta WhatsApp Cloud API). Webhook URL: https://<your-domain>/api/channels/whatsapp/webhook
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any random string of 16+ characters; paste the same value into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Shown to staff in Account > Apps, e.g. +91 98765 43210
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_API_VERSION=v23.0

# Microsoft Teams (Azure Bot). Messaging endpoint: https://<your-domain>/api/channels/teams/messages
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
# Your Microsoft Entra tenant (directory) ID; required in production so only your organisation can use the bot
TEAMS_TENANT_ID=
TEAMS_BOT_NAME=Nova

# Email (a dedicated mailbox read over IMAP; replies are sent with the SMTP_* settings above)
EMAIL_CHANNEL_IMAP_HOST=
EMAIL_CHANNEL_IMAP_PORT=993
EMAIL_CHANNEL_USER=
EMAIL_CHANNEL_PASSWORD=
# Address staff write to (defaults to EMAIL_CHANNEL_USER)
EMAIL_CHANNEL_ADDRESS=
EMAIL_CHANNEL_NAME=Nova
EMAIL_CHANNEL_FOLDER=INBOX
EMAIL_CHANNEL_POLL_SECONDS=60
# Server name in the Authentication-Results header that YOUR mailbox adds: mx.google.com for Gmail /
# Google Workspace; "first" for Microsoft 365. Mail that didn't pass DMARC/DKIM there is ignored.
EMAIL_CHANNEL_AUTHSERV_ID=
# Set false to poll with cron instead:  flask --app app channels --poll-email
EMAIL_CHANNEL_POLLER=true
